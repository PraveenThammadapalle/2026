//Write a C program to implement a non-blocking timer using a counter. 
//The timer should generate an event after a specified time without using a blocking delay loop.

#include <stdio.h>

#define TIMER_PERIOD 5

typedef struct
{
    unsigned int counter;
    unsigned int period;
} Timer;

void timer_init(Timer *timer, unsigned int period)
{
    timer->counter = 0;
    timer->period = period;
}

int timer_update(Timer *timer)
{
    timer->counter++;

    if (timer->counter >= timer->period)
    {
        timer->counter = 0;
        return 1;
    }

    return 0;
}

int main(void)
{
    Timer timer;
    int i;

    timer_init(&timer, TIMER_PERIOD);

    for (i = 0; i < 20; i++)
    {
        printf("Main loop running: %d\n", i);

        if (timer_update(&timer))
        {
            printf("Timer event generated\n");
        }
    }

    return 0;
}
