//Write a C program to demonstrate communication between an ISR and a task using a volatile flag.

#include <stdio.h>

volatile int event_flag = 0;

void ISR(void)
{
    event_flag = 1;
}

void task(void)
{
    if (event_flag == 1)
    {
        printf("Task: Event received from ISR\n");

        event_flag = 0;
    }
}

int main(void)
{
    printf("System started\n");

    printf("ISR occurred\n");

    ISR();

    task();

    return 0;
}
