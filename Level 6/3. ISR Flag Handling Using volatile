//Write a C program to demonstrate how a volatile flag can be used for communication between an ISR and the main program.

#include <stdio.h>

volatile int interrupt_flag = 0;

void ISR(void)
{
    interrupt_flag = 1;
}

int main(void)
{
    printf("Waiting for interrupt...\n");

    /* Simulate interrupt */
    ISR();

    if (interrupt_flag == 1)
    {
        printf("Interrupt received\n");

        interrupt_flag = 0;
    }

    return 0;
}
