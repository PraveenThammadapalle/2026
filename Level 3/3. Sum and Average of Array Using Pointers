//Write a C program to find the sum and average of all elements in an integer array using pointers. Take the array size and elements from the user. Implement the calculation using a separate function.

#include <stdio.h>

#define MAX_SIZE 100

void calculate_sum_average(int *arr, int n, int *sum, float *average)
{
    int i;

    *sum = 0;

    for (i = 0; i < n; i++)
    {
        *sum = *sum + *(arr + i);
    }

    *average = (float)*sum / n;
}

int main(void)
{
    int arr[MAX_SIZE];
    int n;
    int i;
    int sum;
    float average;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_SIZE)
    {
        printf("Invalid array size\n");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    calculate_sum_average(arr, n, &sum, &average);

    printf("Sum = %d\n", sum);
    printf("Average = %.2f\n", average);

    return 0;
}
