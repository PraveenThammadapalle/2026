// Write a C program to access and print all elements of an array using pointer arithmetic instead of array indexing.

#include <stdio.h>

#define MAX_SIZE 100

void print_array(int *ptr, int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        printf("%d ", *(ptr + i));
    }

    printf("\n");
}

int main(void)
{
    int arr[MAX_SIZE];
    int n;
    int i;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_SIZE)
    {
        printf("Invalid array size\n");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Array elements using pointer arithmetic:\n");

    print_array(arr, n);

    return 0;
}


