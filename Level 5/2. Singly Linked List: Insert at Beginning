//Write a C program to insert a new node at the beginning of a singly linked list.

#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

struct Node *insert_beginning(struct Node *head, int data)
{
    struct Node *new_node;

    new_node = malloc(sizeof(struct Node));

    if (new_node == NULL)
    {
        return head;
    }

    new_node->data = data;
    new_node->next = head;

    head = new_node;

    return head;
}

void display(struct Node *head)
{
    struct Node *temp = head;

    while (temp != NULL)
    {
        printf("%d ", temp->data);
        temp = temp->next;
    }

    printf("\n");
}

int main(void)
{
    struct Node *head = NULL;
    int n;
    int i;
    int data;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter data: ");
        scanf("%d", &data);

        head = insert_beginning(head, data);
    }

    printf("Linked List: ");
    display(head);

    printf("Enter new data to insert at beginning: ");
    scanf("%d", &data);

    head = insert_beginning(head, data);

    printf("After insertion: ");
    display(head);

    return 0;
}
