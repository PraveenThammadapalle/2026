//Write a C program to find the number that occurs an odd number of times in an integer array using the XOR operator. 
//Assume all other numbers occur an even number of times.

#include <stdio.h>
#define MAX_SIZE 100

int find_odd_occurring(int arr[], int n)
{
    int result = 0;
    int i;
    for (i = 0; i < n; i++)
    {
        result = result ^ arr[i];
    }
    return result;
}

int main(void)
{
    int arr[MAX_SIZE];
    int n;
    int i;
    int result;

    printf("Enter array size: ");
    scanf("%d", &n);
    if (n <= 0 || n > MAX_SIZE)
    {
        printf("Invalid array size\n");
        return 1;
    }
    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }
    result = find_odd_occurring(arr, n);
    printf("Odd occurring number = %d\n", result);
    return 0;
}

