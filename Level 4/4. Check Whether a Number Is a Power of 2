//Write a C program to check whether a given unsigned integer is a power of 2 using bitwise operators.

#include <stdio.h>

int is_power_of_two(unsigned int value)
{
    if (value == 0)
    {
        return 0;
    }

    if ((value & (value - 1)) == 0)
    {
        return 1;
    }

    return 0;
}

int main(void)
{
    unsigned int value;

    printf("Enter a number: ");
    scanf("%u", &value);

    if (is_power_of_two(value))
    {
        printf("%u is a power of 2\n", value);
    }
    else
    {
        printf("%u is not a power of 2\n", value);
    }

    return 0;
}
