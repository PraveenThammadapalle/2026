//Write a C program to reverse all bits of a 32-bit unsigned integer using bitwise operators.

#include <stdio.h>

unsigned int reverse_bits(unsigned int value)
{
    unsigned int result = 0;
    int i;

    for (i = 0; i < 32; i++)
    {
        result = result << 1;
        result = result | (value & 1U);

        value = value >> 1;
    }

    return result;
}

int main(void)
{
    unsigned int value;
    unsigned int result;

    printf("Enter a number: ");
    scanf("%u", &value);

    result = reverse_bits(value);

    printf("Reversed bits value = %u\n", result);

    return 0;
}
