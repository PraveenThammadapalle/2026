// Write a C program to remove all spaces from a string using a function.

//1. Array Version
#include <stdio.h>

#define MAX_SIZE 100

void remove_spaces(char str[])
{
    int i = 0;
    int j = 0;

    while (str[i] != '\0')
    {
        if (str[i] != ' ')
        {
            str[j] = str[i];
            j++;
        }

        i++;
    }

    str[j] = '\0';
}

int main(void)
{
    char str[MAX_SIZE];

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    remove_spaces(str);

    printf("String without spaces: %s\n", str);

    return 0;
}


#####################################################
//Pointer version
#include <stdio.h>

#define MAX_SIZE 100

void remove_spaces(char *str)
{
    char *read;
    char *write;

    read = str;
    write = str;

    while (*read != '\0')
    {
        if (*read != ' ')
        {
            *write = *read;
            write++;
        }

        read++;
    }

    *write = '\0';
}

int main(void)
{
    char str[MAX_SIZE];

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    remove_spaces(str);

    printf("String without spaces: %s\n", str);

    return 0;
}
