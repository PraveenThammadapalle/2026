//Write a C program to compare two strings without using strcmp().
#include <stdio.h>

#define MAX_SIZE 100

int string_compare(const char str1[], const char str2[])
{
    int i = 0;

    while ((str1[i] != '\0') &&
           (str2[i] != '\0'))
    {
        if (str1[i] != str2[i])
        {
            return 0;
        }

        i++;
    }

    if (str1[i] == str2[i])
        return 1;

    return 0;
}

int main(void)
{
    char str1[MAX_SIZE];
    char str2[MAX_SIZE];

    printf("Enter first string: ");
    scanf("%99[^\n]", str1);

    /*
     * Remove the newline left in input buffer
     */
    getchar();

    printf("Enter second string: ");
    scanf("%99[^\n]", str2);

    if (string_compare(str1, str2))
    {
        printf("Strings are equal\n");
    }
    else
    {
        printf("Strings are not equal\n");
    }

    return 0;
}
###############################################################
Pointer version:
int string_compare(const char *str1, const char *str2)
{
    while (*str1 != '\0' && *str2 != '\0')
    {
        if (*str1 != *str2)
            return 0;


        str1++;
        str2++;
    }


    return (*str1 == *str2);
}
