#include <stdio.h>

#define MAX_SIZE 100

void to_lowercase(char *str)
{
    while (*str != '\0')
    {
        if (*str >= 'A' && *str <= 'Z')
        {
            *str = *str - 'A' + 'a';
        }

        str++;
    }
}

int main(void)
{
    char str[MAX_SIZE];

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    to_lowercase(str);

    printf("Lowercase: %s\n", str);

    return 0;
}
