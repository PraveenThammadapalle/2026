//Write a C program to check whether a string is a palindrome using a function.

#include <stdio.h>

#define MAX_SIZE 100

int is_palindrome(char str[])
{
    int start = 0;
    int end = 0;

    while (str[end] != '\0')
    {
        end++;
    }

    end--;

    while (start < end)
    {
        if (str[start] != str[end])
        {
            return 0;
        }

        start++;
        end--;
    }

    return 1;
}

int main(void)
{
    char str[MAX_SIZE];

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    if (is_palindrome(str))
    {
        printf("Palindrome\n");
    }
    else
    {
        printf("Not Palindrome\n");
    }

    return 0;
}

###########################################################################
int is_palindrome(char *str)
{
    char *start = str;
    char *end = str;

    while (*end != '\0')
    {
        end++;
    }

    end--;

    while (start < end)
    {
        if (*start != *end)
            return 0;

        start++;
        end--;
    }

    return 1;
}
