//Write a C program to copy one string into another without using strcpy().

#include <stdio.h>

#define MAX_SIZE 100

void string_copy(char dest[], const char src[])
{
    int i = 0;

    while (src[i] != '\0')
    {
        dest[i] = src[i];
        i++;
    }

    dest[i] = '\0';
}

int main(void)
{
    char source[MAX_SIZE];
    char destination[MAX_SIZE];

    printf("Enter source string: ");
    scanf("%99[^\n]", source);

    string_copy(destination, source);

    printf("Source      : %s\n", source);
    printf("Destination : %s\n", destination);

    return 0;
}
############################################################################
//Pointer version
void string_copy(char *dest, const char *src)
{
    while (*src != '\0')
    {
        *dest = *src;

        dest++;
        src++;
    }

    *dest = '\0';
}
