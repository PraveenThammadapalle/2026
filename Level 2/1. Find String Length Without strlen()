Pointer version:
#include <stdio.h>

#define MAX_SIZE 100

int string_length(char *str)
{
    int length = 0;

    while (*str != '\0')
    {
        length++;
        str++;
    }

    return length;
}
int main(void)
{
    char str[MAX_SIZE];
    int length;

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    length = string_length(str);

    printf("String length = %d\n", length);

    return 0;
}
