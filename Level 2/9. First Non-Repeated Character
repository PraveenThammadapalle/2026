//Write a C program to find the first character that occurs only once in a string.

#include <stdio.h>

#define MAX_SIZE 100
#define ASCII_SIZE 256

char first_non_repeated(char str[])
{
    int frequency[ASCII_SIZE] = {0};
    int i;

    /* Count frequency */
    for (i = 0; str[i] != '\0'; i++)
    {
        frequency[(unsigned char)str[i]]++;
    }

    /* Find first character with frequency 1 */
    for (i = 0; str[i] != '\0'; i++)
    {
        if (frequency[(unsigned char)str[i]] == 1)
        {
            return str[i];
        }
    }

    return '\0';
}

int main(void)
{
    char str[MAX_SIZE];
    char result;

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    result = first_non_repeated(str);

    if (result != '\0')
    {
        printf("First non-repeated character = %c\n", result);
    }
    else
    {
        printf("No non-repeated character found\n");
    }

    return 0;
}

