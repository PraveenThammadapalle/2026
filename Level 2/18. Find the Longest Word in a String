//Pointer version
#include <stdio.h>

#define MAX_SIZE 100

void find_longest_word(const char *str)
{
    const char *ptr;
    const char *word_start;
    const char *longest_start;

    int current_length = 0;
    int max_length = 0;

    ptr = str;
    word_start = str;
    longest_start = str;

    while (*ptr != '\0')
    {
        if (*ptr != ' ')
        {
            current_length++;
        }
        else
        {
            if (current_length > max_length)
            {
                max_length = current_length;
                longest_start = word_start;
            }

            current_length = 0;
            word_start = ptr + 1;
        }

        ptr++;
    }

    /* Check last word */
    if (current_length > max_length)
    {
        max_length = current_length;
        longest_start = word_start;
    }

    printf("Longest word: ");

    ptr = longest_start;

    while (*ptr != '\0' && *ptr != ' ')
    {
        putchar(*ptr);
        ptr++;
    }

    printf("\n");
}

int main(void)
{
    char str[MAX_SIZE];

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    find_longest_word(str);

    return 0;
}


