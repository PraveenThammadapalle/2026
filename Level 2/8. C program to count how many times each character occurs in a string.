#include <stdio.h>

#define MAX_SIZE 100
#define ASCII_SIZE 256

void count_frequency(const char *str)
{
    int frequency[ASCII_SIZE] = {0};
    const char *ptr;
    int i;

    ptr = str;

    /* Count frequency */
    while (*ptr != '\0')
    {
        frequency[(unsigned char)*ptr]++;
        ptr++;
    }

    /* Display frequency */
    for (i = 0; i < ASCII_SIZE; i++)
    {
        if (frequency[i] != 0)
        {
            printf("%c = %d\n", i, frequency[i]);
        }
    }
}

int main(void)
{
    char str[MAX_SIZE];

    printf("Enter a string: ");
    scanf("%99[^\n]", str);

    count_frequency(str);

    return 0;
}
