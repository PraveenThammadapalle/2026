//Write a C program to count how many times a given word occurs in a string.

//1. Array Version

#include <stdio.h>

#define MAX_SIZE 200

int string_compare(const char *str1, const char *str2, int length)
{
    int i;

    for (i = 0; i < length; i++)
    {
        if (str1[i] != str2[i])
            return 0;
    }

    return 1;
}

int count_word(char str[], char word[])
{
    int i;
    int j;
    int count = 0;
    int word_length = 0;

    /* Find word length */
    while (word[word_length] != '\0')
    {
        word_length++;
    }

    for (i = 0; str[i] != '\0'; i++)
    {
        if (str[i] == word[0])
        {
            if (string_compare(&str[i], word, word_length))
            {
                /*
                 * Check word boundary
                 */
                if ((i == 0 || str[i - 1] == ' ') &&
                    (str[i + word_length] == '\0' ||
                     str[i + word_length] == ' '))
                {
                    count++;
                }
            }
        }
    }

    return count;
}

int main(void)
{
    char str[MAX_SIZE];
    char word[MAX_SIZE];
    int count;

    printf("Enter a string: ");
    scanf("%199[^\n]", str);

    getchar();

    printf("Enter word to search: ");
    scanf("%199[^\n]", word);

    count = count_word(str, word);

    printf("'%s' occurs %d times\n", word, count);

    return 0;
}

//Pointer Version
#include <stdio.h>

#define MAX_SIZE 200

int compare_word(const char *str,
                 const char *word,
                 int length)
{
    int i;

    for (i = 0; i < length; i++)
    {
        if (str[i] != word[i])
            return 0;
    }

    return 1;
}

int count_word(const char *str, const char *word)
{
    const char *ptr;
    int word_length = 0;
    int count = 0;

    /* Find word length */
    while (word[word_length] != '\0')
    {
        word_length++;
    }

    ptr = str;

    while (*ptr != '\0')
    {
        if (*ptr == *word)
        {
            if (compare_word(ptr, word, word_length))
            {
                /*
                 * Check beginning and ending
                 * of the word
                 */
                if ((ptr == str || *(ptr - 1) == ' ') &&
                    (*(ptr + word_length) == '\0' ||
                     *(ptr + word_length) == ' '))
                {
                    count++;
                }
            }
        }

        ptr++;
    }

    return count;
}

int main(void)
{
    char str[MAX_SIZE];
    char word[MAX_SIZE];
    int count;

    printf("Enter a string: ");
    scanf("%199[^\n]", str);

    getchar();

    printf("Enter word to search: ");
    scanf("%199[^\n]", word);

    count = count_word(str, word);

    printf("'%s' occurs %d times\n", word, count);

    return 0;
}
