4. Using Pointer Variables Inside Function

#include <stdio.h>

void swap(int *a, int *b)
{
    int *temp;

    temp = a;

    a = b;
    b = temp;
}

int main(void)
{
    int a, b;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    swap(&a, &b);

    printf("a = %d, b = %d\n", a, b);

    return 0;
}
