Write a C program to find the factorial of a given number using a function.
#####################################################################################
#include <stdio.h>

int factorial(int n)
{
    int fact = 1;
    int i;

    for (i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

int main(void)
{
    int n;
    int result;

    printf("Enter a number: ");
    scanf("%d", &n);

    result = factorial(n);

    printf("Factorial = %d\n", result);

    return 0;
}

