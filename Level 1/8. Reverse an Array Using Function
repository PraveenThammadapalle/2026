//Reverse an Array Using Function
###############################################
#include <stdio.h>

#define MAX_SIZE 100

void reverse_array(int arr[], int n)
{
    int i = 0;
    int j = n - 1;
    int temp;

    while (i < j)
    {
        temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;

        i++;
        j--;
    }
}

int main(void)
{
    int arr[MAX_SIZE];
    int n;
    int i;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_SIZE)
    {
        printf("Invalid array size\n");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    reverse_array(arr, n);

    printf("Reversed array:\n");

    for (i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    printf("\n");

    return 0;
}

