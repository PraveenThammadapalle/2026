If the interviewer asks:

Find all occurrences instead of the first occurrence.

#include <stdio.h>

#define MAX_SIZE 100

void find_all(int arr[], int n, int key)
{
    int i;
    int found = 0;

    for (i = 0; i < n; i++)
    {
        if (arr[i] == key)
        {
            printf("Found at index %d\n", i);
            found = 1;
        }
    }

    if (found == 0)
    {
        printf("Element not found\n");
    }
}

int main(void)
{
    int arr[MAX_SIZE];
    int n;
    int i;
    int key;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_SIZE)
    {
        printf("Invalid array size\n");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &key);

    find_all(arr, n, key);

    return 0;
}
