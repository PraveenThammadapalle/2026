//Smallest Element, Largest Element, together, second largest 
#include <stdio.h>

#define MAX_SIZE 100

/* Find Largest */
int find_largest(int arr[], int n)
{
    int max = arr[0];
    int i;

    for (i = 1; i < n; i++)
    {
        if (arr[i] > max)
            max = arr[i];
    }

    return max;
}

/* Find Smallest */
int find_smallest(int arr[], int n)
{
    int min = arr[0];
    int i;

    for (i = 1; i < n; i++)
    {
        if (arr[i] < min)
            min = arr[i];
    }

    return min;
}

/* Find Largest and Smallest Together */
void find_min_max(int arr[], int n, int *min, int *max)
{
    int i;

    *min = arr[0];
    *max = arr[0];

    for (i = 1; i < n; i++)
    {
        if (arr[i] < *min)
            *min = arr[i];

        if (arr[i] > *max)
            *max = arr[i];
    }
}

/* Find Second Largest */
int find_second_largest(int arr[], int n)
{
    int largest;
    int second;
    int i;

    if (n < 2)
        return 0;

    largest = arr[0];
    second = 0;

    for (i = 1; i < n; i++)
    {
        if (arr[i] > largest)
        {
            second = largest;
            largest = arr[i];
        }
        else if ((arr[i] > second) &&
                 (arr[i] != largest))
        {
            second = arr[i];
        }
    }

    return second;
}

/* Find Largest Using Pointer */
int find_largest_pointer(int *arr, int n)
{
    int max = *arr;
    int *ptr;

    ptr = arr + 1;

    while (ptr < arr + n)
    {
        if (*ptr > max)
            max = *ptr;

        ptr++;
    }

    return max;
}

int main(void)
{
    int arr[MAX_SIZE];

    int n;
    int i;

    int largest;
    int smallest;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_SIZE)
    {
        printf("Invalid array size\n");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    /* 1. Largest */
    largest = find_largest(arr, n);
    printf("\nLargest = %d\n", largest);

    /* 2. Smallest */
    smallest = find_smallest(arr, n);
    printf("Smallest = %d\n", smallest);

    /* 3. Largest and Smallest Together */
    find_min_max(arr, n, &smallest, &largest);

    printf("Min and Max together:\n");
    printf("Smallest = %d\n", smallest);
    printf("Largest  = %d\n", largest);

    /* 4. Second Largest */
    if (n >= 2)
    {
        printf("Second Largest = %d\n",
               find_second_largest(arr, n));
    }
    else
    {
        printf("Second Largest = Not Available\n");
    }

    /* 5. Largest using pointer */
    largest = find_largest_pointer(arr, n);

    printf("Largest using pointer = %d\n", largest);

    return 0;
}
